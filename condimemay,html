<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile Card</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: url('https://media1.giphy.com/media/v1.Y2lkPTc5MGI3NjExM3ptN21wcHVseWs2cnhjdHF2b3RuMGR4Y2doYndiOHo0d2Y1MTE0aiZlcD12MV9pbnRlcm5hbF9naWZfYnlfaWQmY3Q9Zw/xTcnT45z6H5gxFYZZS/giphy.gif') center/cover fixed;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
            overflow-x: hidden;
            position: relative;
        }

        body::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.3);
            z-index: 0;
        }

        .container {
            width: 100%;
            max-width: 500px;
            opacity: 0;
            animation: fadeIn 1.5s ease-out forwards;
            position: relative;
            z-index: 1;
        }

        @keyframes fadeIn {
            to {
                opacity: 1;
            }
        }

        .banner {
            width: 100%;
            height: 200px;
            border-radius: 20px 20px 0 0;
            overflow: hidden;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
            animation: slideDown 1s ease-out 0.5s backwards;
        }

        @keyframes slideDown {
            from {
                transform: translateY(-100px);
                opacity: 0;
            }
        }

        .banner img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .profile-card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border-radius: 0 0 20px 20px;
            padding: 40px 30px 30px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3),
                        0 0 60px rgba(255, 105, 180, 0.3);
            position: relative;
            animation: slideUp 1s ease-out 0.8s backwards, cardGlow 3s ease-in-out infinite;
        }

        @keyframes cardGlow {
            0%, 100% {
                box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3),
                            0 0 60px rgba(255, 105, 180, 0.3);
            }
            50% {
                box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3),
                            0 0 80px rgba(147, 51, 234, 0.5);
            }
        }

        @keyframes slideUp {
            from {
                transform: translateY(100px);
                opacity: 0;
            }
        }

        .avatar-container {
            position: absolute;
            top: -60px;
            left: 50%;
            transform: translateX(-50%);
            animation: scaleIn 0.8s ease-out 1.2s backwards;
        }

        @keyframes scaleIn {
            from {
                transform: translateX(-50%) scale(0);
            }
        }

        .avatar {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            border: 5px solid white;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.3),
                        0 0 30px rgba(255, 105, 180, 0.6),
                        0 0 50px rgba(255, 105, 180, 0.4);
            object-fit: cover;
            animation: avatarGlow 2s ease-in-out infinite;
        }

        @keyframes avatarGlow {
            0%, 100% {
                box-shadow: 0 5px 20px rgba(0, 0, 0, 0.3),
                            0 0 30px rgba(255, 105, 180, 0.6),
                            0 0 50px rgba(255, 105, 180, 0.4);
            }
            50% {
                box-shadow: 0 5px 20px rgba(0, 0, 0, 0.3),
                            0 0 40px rgba(147, 51, 234, 0.8),
                            0 0 60px rgba(147, 51, 234, 0.6);
            }
        }

        .profile-info {
            margin-top: 70px;
            text-align: center;
        }

        .name {
            font-size: 28px;
            font-weight: bold;
            color: #333;
            margin-bottom: 20px;
            animation: fadeInText 1s ease-out 1.5s backwards, rainbowText 3s linear infinite;
            text-shadow: 0 0 10px rgba(255, 255, 255, 0.8),
                         0 0 20px rgba(255, 255, 255, 0.6),
                         0 0 30px rgba(255, 255, 255, 0.4);
        }

        @keyframes rainbowText {
            0% { color: #ff0000; }
            14% { color: #ff7f00; }
            28% { color: #ffff00; }
            42% { color: #00ff00; }
            57% { color: #0000ff; }
            71% { color: #4b0082; }
            85% { color: #9400d3; }
            100% { color: #ff0000; }
        }

        @keyframes fadeInText {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
        }

        .welcome-text {
            font-size: 16px;
            color: #ff69b4;
            margin-bottom: 25px;
            animation: blink 2s ease-in-out infinite, fadeInText 1s ease-out 1.7s backwards, rainbowGlow 2s linear infinite;
            font-weight: 500;
            text-shadow: 0 0 10px currentColor,
                         0 0 20px currentColor,
                         0 0 30px currentColor;
        }

        @keyframes blink {
            0%, 100% {
                opacity: 1;
            }
            50% {
                opacity: 0.4;
            }
        }

        @keyframes rainbowGlow {
            0% { color: #ff69b4; text-shadow: 0 0 10px #ff69b4, 0 0 20px #ff69b4, 0 0 30px #ff69b4; }
            14% { color: #ff1493; text-shadow: 0 0 10px #ff1493, 0 0 20px #ff1493, 0 0 30px #ff1493; }
            28% { color: #ff00ff; text-shadow: 0 0 10px #ff00ff, 0 0 20px #ff00ff, 0 0 30px #ff00ff; }
            42% { color: #ff69b4; text-shadow: 0 0 10px #ff69b4, 0 0 20px #ff69b4, 0 0 30px #ff69b4; }
            57% { color: #ffc0cb; text-shadow: 0 0 10px #ffc0cb, 0 0 20px #ffc0cb, 0 0 30px #ffc0cb; }
            71% { color: #ff1493; text-shadow: 0 0 10px #ff1493, 0 0 20px #ff1493, 0 0 30px #ff1493; }
            85% { color: #ff69b4; text-shadow: 0 0 10px #ff69b4, 0 0 20px #ff69b4, 0 0 30px #ff69b4; }
            100% { color: #ff69b4; text-shadow: 0 0 10px #ff69b4, 0 0 20px #ff69b4, 0 0 30px #ff69b4; }
        }

        .info-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 15px;
            margin-bottom: 25px;
            animation: fadeInText 1s ease-out 1.9s backwards;
        }

        .info-item {
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            padding: 12px;
            border-radius: 12px;
            text-align: center;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .info-item::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: linear-gradient(
                45deg,
                transparent,
                rgba(255, 255, 255, 0.8),
                transparent
            );
            transform: rotate(45deg);
            animation: shimmer 3s infinite;
        }

        @keyframes shimmer {
            0% {
                transform: translateX(-100%) translateY(-100%) rotate(45deg);
            }
            100% {
                transform: translateX(100%) translateY(100%) rotate(45deg);
            }
        }

        .info-item:hover {
            transform: translateY(-5px) scale(1.05);
            box-shadow: 0 10px 25px rgba(255, 105, 180, 0.4);
            background: linear-gradient(135deg, #ffeef8 0%, #e8d5ff 100%);
        }

        .info-label {
            font-size: 12px;
            color: #666;
            margin-bottom: 5px;
            position: relative;
            z-index: 1;
        }

        .info-value {
            font-size: 14px;
            font-weight: bold;
            color: #333;
            position: relative;
            z-index: 1;
            animation: pulse 2s ease-in-out infinite;
        }

        @keyframes pulse {
            0%, 100% {
                transform: scale(1);
            }
            50% {
                transform: scale(1.05);
            }
        }

        .social-links {
            display: flex;
            justify-content: center;
            gap: 20px;
            animation: fadeInText 1s ease-out 2.1s backwards;
        }

        .social-icon {
            width: 50px;
            height: 50px;
            border-radius: 12px;
            overflow: hidden;
            transition: all 0.3s ease;
            cursor: pointer;
            box-shadow: 0 3px 10px rgba(0, 0, 0, 0.2);
            position: relative;
        }

        .social-icon::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: radial-gradient(circle, rgba(255,255,255,0.8) 0%, rgba(255,255,255,0) 70%);
            opacity: 0;
            transition: opacity 0.3s ease;
            animation: iconPulse 2s ease-in-out infinite;
        }

        @keyframes iconPulse {
            0%, 100% {
                box-shadow: 0 0 10px rgba(255, 105, 180, 0.4);
            }
            50% {
                box-shadow: 0 0 20px rgba(255, 105, 180, 0.8),
                            0 0 30px rgba(147, 51, 234, 0.6);
            }
        }

        .social-icon:hover::before {
            opacity: 1;
        }

        .social-icon:hover {
            transform: scale(1.2) rotate(5deg);
            box-shadow: 0 10px 30px rgba(255, 105, 180, 0.8),
                        0 0 40px rgba(147, 51, 234, 0.6);
        }

        .social-icon img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .notification {
            position: fixed;
            top: 20px;
            right: 20px;
            background: rgba(255, 255, 255, 0.95);
            padding: 15px 20px;
            border-radius: 10px;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.3);
            opacity: 0;
            transform: translateX(400px);
            transition: all 0.3s ease;
            z-index: 1000;
        }

        .notification.show {
            opacity: 1;
            transform: translateX(0);
        }

        @media (max-width: 480px) {
            .banner {
                height: 150px;
            }

            .info-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="banner">
            <img src="https://media0.giphy.com/media/v1.Y2lkPTc5MGI3NjExdGZwZHd3NjJ4YmN3cjJuY2hkbmdsMGRrdXh5ZGprNXM4amxpZmxwbCZlcD12MV9pbnRlcm5hbF9naWZfYnlfaWQmY3Q9Zw/xxSprBorM4fVvhjeFQ/giphy.gif" alt="Banner">
        </div>

        <div class="profile-card">
            <div class="avatar-container">
                <img src="https://i.postimg.cc/d1DdmqFK/Screenshot-2025-12-27-164743.jpg" alt="Avatar" class="avatar">
            </div>

            <div class="profile-info">
                <h1 class="name">Minh Sơn</h1>
                <p class="welcome-text">✨ Chào mừng đến với trang cá nhân của mình! ✨</p>

                <div class="info-grid">
                    <div class="info-item">
                        <div class="info-label">Tuổi</div>
                        <div class="info-value">20</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Sở thích</div>
                        <div class="info-value">Coding & Gaming</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Game yêu thích</div>
                        <div class="info-value">Valorant</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Nơi sinh</div>
                        <div class="info-value">Việt Nam</div>
                    </div>
                </div>

                <div class="social-links">
                    <div class="social-icon" onclick="openFacebook()">
                        <img src="https://i.postimg.cc/XJDmNc46/snapedit-1768848020510.png" alt="Facebook">
                    </div>
                    <div class="social-icon" onclick="openGithub()">
                        <img src="https://i.postimg.cc/ydYC88RR/snapedit-1768848008009.png" alt="GitHub">
                    </div>
                    <div class="social-icon" onclick="copyDiscord()">
                        <img src="https://i.postimg.cc/j21b9YL4/snapedit-1768848037935.png" alt="Discord">
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="notification" id="notification"></div>

    <audio id="backgroundMusic"></audio>

    <script>
        const songs = [
            'http://short-link-nvh.onrender.com/eacat3',
            'http://short-link-nvh.onrender.com/Yo4Sz7',
            'http://short-link-nvh.onrender.com/s2bfzc',
            'http://short-link-nvh.onrender.com/eviVsO'
        ];

        const music = document.getElementById('backgroundMusic');
        const randomSong = songs[Math.floor(Math.random() * songs.length)];
        music.src = randomSong;
        music.volume = 0.3;
        music.loop = true;

        document.addEventListener('click', function playMusic() {
            music.play().catch(e => console.log('Autoplay prevented'));
            document.removeEventListener('click', playMusic);
        }, { once: true });

        function showNotification(message) {
            const notification = document.getElementById('notification');
            notification.textContent = message;
            notification.classList.add('show');
            
            setTimeout(() => {
                notification.classList.remove('show');
            }, 3000);
        }

        function openFacebook() {
            window.open('https://www.facebook.com/ditcuthilo?locale=vi_VN', '_blank');
            showNotification('Đang mở Facebook...');
        }

        function openGithub() {
            window.open('https://github.com/minhsonXavia', '_blank');
            showNotification('Đang mở GitHub...');
        }

        function copyDiscord() {
            const discordId = 'skibidi_15743';
            navigator.clipboard.writeText(discordId).then(() => {
                showNotification('✓ Đã copy Discord ID: ' + discordId);
            }).catch(() => {
                showNotification('Discord ID: ' + discordId);
            });
        }
    </script>
</body>
</html>
